# Port for backend server
PORT=3001

# AI provider selection:
# - auto: use the first available key in this order: Anthropic, OpenAI, Gemini
# - anthropic | openai | gemini: force a provider
# Leave all API keys empty to use demo mode.
AI_PROVIDER=auto

# Anthropic API Key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CORS origin for frontend
FRONTEND_URL=http://localhost:5173
